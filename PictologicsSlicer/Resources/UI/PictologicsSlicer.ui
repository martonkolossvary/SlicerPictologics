    <widget class="QProgressBar" name="progressBar">
     <property name="value"><number>0</number></property>
     <property name="textVisible"><bool>true</bool></property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="elapsedTimeLabel">
     <property name="text"><string>Elapsed: 00:00:00</string></property>
     <property name="toolTip"><string>Total wall time since Run was selected, including dependency checks and input preparation. Not an estimate of time remaining.</string></property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="statusLabel">
     <property name="text"><string>No run started.</string></property>
     <property name="wordWrap"><bool>true</bool></property>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="profilesCollapsibleButton">
     <property name="text"><string>Configuration profiles</string></property>
     <property name="collapsed"><bool>true</bool></property>
     <layout class="QVBoxLayout" name="profilesLayout">
      <item><layout class="QHBoxLayout" name="profileButtonsLayout">
       <item><widget class="QPushButton" name="loadProfileButton"><property name="text"><string>Load…</string></property></widget></item>
       <item><widget class="QPushButton" name="saveProfileButton"><property name="text"><string>Save…</string></property><property name="toolTip"><string>Save checked presets and in-app settings. Advanced configuration files remain a separate workflow.</string></property></widget></item>
       <item><widget class="QPushButton" name="duplicateProfileButton"><property name="text"><string>Save copy…</string></property><property name="toolTip"><string>Save current settings as a new named profile without replacing the original file.</string></property></widget></item>
      </layout></item>
      <item><widget class="QLabel" name="profileStatusLabel"><property name="text"><string>Profiles contain settings only; no patient data.</string></property><property name="wordWrap"><bool>true</bool></property><property name="textFormat"><enum>Qt::PlainText</enum></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="batchCollapsibleButton">
     <property name="text"><string>Batch</string></property>
     <property name="collapsed"><bool>true</bool></property>
     <layout class="QFormLayout" name="batchFormLayout">
      <item row="0" column="0"><widget class="QLabel" name="batchFolderLabel"><property name="text"><string>Study folder:</string></property></widget></item>
      <item row="0" column="1">
       <layout class="QHBoxLayout" name="batchFolderLayout">
        <item><widget class="QLineEdit" name="batchFolderLineEdit"><property name="placeholderText"><string>Folder with one subfolder for each case</string></property></widget></item>
        <item><widget class="QPushButton" name="batchBrowseButton"><property name="text"><string>Browse…</string></property></widget></item>
       </layout>
      </item>
      <item row="1" column="0"><widget class="QLabel" name="batchImageLabel"><property name="text"><string>Image file:</string></property></widget></item>
      <item row="1" column="1"><widget class="QLineEdit" name="batchImagePatternLineEdit"><property name="text"><string>image.nii.gz</string></property><property name="toolTip"><string>Name of the image file in each case folder. A pattern such as *.nrrd is allowed; it must match exactly one file.</string></property></widget></item>
      <item row="2" column="0"><widget class="QLabel" name="batchSegmentationLabel"><property name="text"><string>Segmentation file:</string></property></widget></item>
      <item row="2" column="1"><widget class="QLineEdit" name="batchSegmentationPatternLineEdit"><property name="text"><string>segmentation.seg.nrrd</string></property><property name="toolTip"><string>Name or pattern of the segmentation or label map file in each case folder. Leave it empty to analyze only the whole volume.</string></property></widget></item>
      <item row="3" column="0" colspan="2"><widget class="QLabel" name="batchHelpLabel"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>Each subfolder is one case, and its name becomes the subject ID. Every segment is a region. The configurations, reader, extra columns, and crop setting above apply to every case. The rows of all cases go into the results table.</string></property></widget></item>
      <item row="4" column="0" colspan="2"><widget class="QPushButton" name="runBatchButton"><property name="text"><string>Run batch…</string></property></widget></item>
      <item row="5" column="0"><widget class="QLabel" name="batchReportLabel"><property name="text"><string>Saved batch report:</string></property></widget></item>
      <item row="5" column="1"><widget class="QComboBox" name="batchReportCombo"><property name="toolTip"><string>Reports are saved in the Slicer scene with the case outcomes.</string></property></widget></item>
      <item row="6" column="0" colspan="2">
       <layout class="QHBoxLayout" name="batchReportButtonsLayout">
        <item><widget class="QPushButton" name="viewBatchReportButton"><property name="text"><string>View report</string></property></widget></item>
        <item><widget class="QPushButton" name="exportBatchReportButton"><property name="text"><string>Export report…</string></property></widget></item>
       </layout>
      </item>
      <item row="7" column="0" colspan="2"><widget class="QLabel" name="batchReportHelpLabel"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>Reports include completed, partial, failed, skipped, cancelled, and interrupted cases. Save the scene or export JSON/CSV before closing it.</string></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="packageCollapsibleButton">
     <property name="text"><string>Pictologics package</string></property>
     <property name="collapsed"><bool>true</bool></property>
     <layout class="QHBoxLayout" name="packageLayout">
      <item>
       <widget class="QLabel" name="packageVersionLabel">
