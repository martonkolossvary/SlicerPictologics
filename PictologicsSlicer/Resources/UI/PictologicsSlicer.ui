           <item>
            <widget class="QPushButton" name="newFromPresetButton">
             <property name="text"><string>New from preset…</string></property>
             <property name="toolTip"><string>Write an editable starter configuration file from a standard preset.</string></property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="validateConfigButton">
             <property name="text"><string>Validate</string></property>
             <property name="toolTip"><string>Load the selected file with the installed Pictologics, as a run loads it. Before Pictologics is installed, this is only a quick structural check.</string></property>
