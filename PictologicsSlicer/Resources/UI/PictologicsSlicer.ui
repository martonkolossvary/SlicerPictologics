   <item>
    <widget class="ctkCollapsibleButton" name="outputCollapsibleButton">
     <property name="text"><string>Output</string></property>
     <layout class="QFormLayout" name="outputFormLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="outputTableLabel">
        <property name="text"><string>Results table:</string></property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="qMRMLNodeComboBox" name="outputTableSelector">
        <property name="nodeTypes"><stringlist><string>vtkMRMLTableNode</string></stringlist></property>
        <property name="noneEnabled"><bool>true</bool></property>
        <property name="addEnabled"><bool>true</bool></property>
        <property name="removeEnabled"><bool>true</bool></property>
        <property name="showHidden"><bool>false</bool></property>
        <property name="showChildNodeTypes"><bool>false</bool></property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QCheckBox" name="appendResultsCheckBox">
        <property name="text"><string>Append to compatible existing rows</string></property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QCheckBox" name="exportWideCheckBox">
        <property name="text"><string>Export wide layout (one row per ROI)</string></property>
        <property name="toolTip"><string>Pivot to one row per ROI using Pictologics' exact configuration__feature_key column names instead of the default long layout.</string></property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QPushButton" name="exportButton">
        <property name="text"><string>Export table as CSV or JSON…</string></property>
        <property name="toolTip"><string>Export the current values at full precision as an independent archive. New Pictologics result tables also carry exact-value backups in saved scenes. Previously rounded values in older scenes cannot be recovered.</string></property>
        <property name="enabled"><bool>false</bool></property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="QPushButton" name="browseResultsButton">
        <property name="text"><string>Browse results and provenance…</string></property>
        <property name="enabled"><bool>false</bool></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QWidget" name="runOptionsWidget" native="true">
     <layout class="QHBoxLayout" name="runOptionsLayout">
      <property name="leftMargin"><number>0</number></property>
      <property name="topMargin"><number>0</number></property>
      <property name="rightMargin"><number>0</number></property>
      <property name="bottomMargin"><number>0</number></property>
      <item>
       <widget class="QCheckBox" name="cropCheckBox">
        <property name="text"><string>Crop around each region (uses less memory)</string></property>
        <property name="checked"><bool>false</bool></property>
        <property name="toolTip"><string>Give Pictologics only a box around each region, with a margin for interpolation, filters, and local-intensity features. This saves much memory for small regions in large scans. The box keeps the resampling grid of the whole scan, so the values agree with a whole-scan run to rounding precision.</string></property>
       </widget>
      </item>
      <item><widget class="QLabel" name="threadsLabel"><property name="text"><string>CPU threads:</string></property></widget></item>
      <item><widget class="QSpinBox" name="threadsSpinBox"><property name="minimum"><number>0</number></property><property name="maximum"><number>256</number></property><property name="specialValueText"><string>Automatic</string></property><property name="toolTip"><string>The number of CPU threads of a run. Automatic uses the fast cores of this computer. Fewer threads keep Slicer more responsive.</string></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="readinessLabel">
     <property name="text"><string>Select an input scalar volume.</string></property>
     <property name="wordWrap"><bool>true</bool></property>
     <property name="toolTip"><string>Input readiness only. Geometry and custom configurations are checked again when the job is prepared and executed.</string></property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="executionButtonLayout">
     <item>
      <widget class="QPushButton" name="runButton">
       <property name="minimumSize"><size><width>150</width><height>0</height></size></property>
       <property name="text"><string>Run radiomics</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="cancelButton">
       <property name="text"><string>Cancel</string></property>
       <property name="enabled"><bool>false</bool></property>
      </widget>
     </item>
    </layout>
